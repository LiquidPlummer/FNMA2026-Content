# ============================================================
# Demos/.gitignore
# Keeps demo repos to SOURCE ONLY. Students should be able to
# clone this and see code, not build caches.
# The repo-root .gitignore also applies (build/, out/, dist/,
# node_modules/, .idea/, .vscode/, *.class, *.jar, *.iml).
# ============================================================

# ---------- Gradle ----------
# KEEP: build.gradle, build.gradle.kts, settings.gradle, settings.gradle.kts, gradle.properties
.gradle/
**/.gradle/
build/
**/build/
gradle-app.setting
.gradletasknamecache

# Gradle wrapper (students use their own local Gradle install)
gradlew
gradlew.bat
gradle/wrapper/
**/gradle/wrapper/

# ---------- Maven ----------
# KEEP: pom.xml
target/
**/target/
.mvn/
**/.mvn/
mvnw
mvnw.cmd
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# ---------- Compiled output / packages ----------
bin/
**/bin/
out/
**/out/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# ---------- IntelliJ IDEA ----------
.idea/
**/.idea/
*.iml
*.ipr
*.iws
out/

# ---------- VS Code ----------
.vscode/
**/.vscode/
.history/
*.code-workspace

# ---------- Eclipse / STS ----------
.settings/
**/.settings/
.project
.classpath
.apt_generated/
.factorypath
.springBeans
.sts4-cache/

# ---------- NetBeans ----------
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ---------- Node / JS ----------
node_modules/
**/node_modules/
dist/
.next/
.parcel-cache/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------- Logs / crash dumps ----------
*.log
logs/
hs_err_pid*
replay_pid*
*.ctxt
.mtj.tmp/

# ---------- Local databases / runtime state ----------
# Generated by the Spring Data / Spring Web demos at runtime
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mv.db
*.trace.db

# ---------- Secrets / local env ----------
.env
.env.*
!.env.example
*.pem
credentials
application-local.properties
application-local.yml

# ---------- OS cruft ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Tooling ----------
.claude/
.metals/
.bloop/
.scala-build/
